# Unity-generated directories
/.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Cc]aptures/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/
/ExportedObj/

# Unity-generated files and editor integrations
/[Aa]ssets/Plugins/Editor/JetBrains*
*.unityproj
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.meta
# Unity 的 Assets 数据库依赖稳定 GUID；只放开项目资产 meta，其他目录继续忽略。
!/[Aa]ssets/**/*.meta
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Unity Test Runner and generated asset caches
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db*
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers*

# Addressables build outputs
/[Ss]erverData/
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Addressables_Temp*

# Build packages and symbol bundles
*.apk
*.aab
*.app
*.ipa
*.dSYM/
*.unitypackage
*.unitypackage.meta

# IDE and local editor state
/.vs/
/.idea/
/.vscode/
/.fleet/
/.consulo/
/.gradle/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.DotSettings.user

# Standalone .NET tooling lives outside Unity's generated project files.
**/[Bb]in/
**/[Oo]bj/
**/[Tt]est[Rr]esults/
!/Tools/ConfigExporter/ConfigExporter.csproj
!/Tools/ConfigExporter/Tests/ConfigExporter.Tests.csproj

# The pinned embedded WeChat SDK vendors Binaryen executables as source inputs.
!/Packages/com.qq.weixin.minigame/Editor/Node/node_modules/binaryen/bin/
!/Packages/com.qq.weixin.minigame/Editor/Node/node_modules/binaryen/bin/**

# Python tooling caches
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
*.py[cod]

# Operating-system metadata
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db

# Temporary and editor backup files
*.tmp
*.bak
*.orig
*.swp
*.swo
*~

# Project-local disposable workspaces
/artifacts/tmp/

# Intentionally versioned: generated gameplay JSON/hash/IDs under Assets,
# task evidence under artifacts/evals (including logs/XML/TRX), and outputs/.
