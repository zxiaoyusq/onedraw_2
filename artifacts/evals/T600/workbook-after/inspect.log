{"kind":"table","sheet":"Texts","address":"A1:D64","rows":64,"cols":4,"values":[["Texts",null,null,null],["所有玩家可见文字配置化，中文字体测试必须覆盖本表字符。",null,null,null],[null,null,null,null],["textKey","zhCN","enUS","context"],["text_player_moyan","玄狸·墨砚","Moyan","玩家名"],["text_stance_blade","斩妖刀","Demon Blade","架势名"],["text_stance_talisman","镇魂笔","Soul Talisman","架势名"],["text_enemy_fire_fish","符火鱼妖","Talisman Firefish","敌人名"],["text_enemy_wheel_zombie","轮车僵妖","Wheel Zombie","敌人名"],["text_enemy_stone_turtle","石甲龟妖","Stone Turtle","敌人名"],["text_enemy_skeleton_ghost","骷髅幽魂","Skeleton Ghost","敌人名"],["text_enemy_talisman_bat","飞行符蝠","Talisman Bat","敌人名"],["text_enemy_soul_puppet","摄魂道傀","Soul Puppet","精英名"],["text_boss_tomb_armor_king","镇墓玄甲王","Tomb Armor King","Boss名"],["text_level_001","幽菌古道","Luminous Fungi Path","关卡名"],["text_level_002","百鬼回廊","Hundred Ghost Gallery","关卡名"],["text_level_003","玄甲镇墓","Tomb of Black Armor","关卡名"],["text_tutorial_swipe","划过妖怪即可攻击","Swipe through monsters to attack","教程"],["text_tutorial_weakpoint","斩中发光弱点可打断并暴击","Hit the glowing weakpoint to interrupt","教程"],["text_tutorial_combo","一笔划过多个目标，连斩更强","Hit multiple targets in one stroke","教程"],["text_tutorial_cut","敌人的法术也可以斩断","Enemy projectiles can be cut","教程"],["text_tutorial_charge","按住片刻再划动，破开重甲","Hold briefly, then swipe to break armor","教程"],["text_tutorial_stance","切换镇魂笔，对幽魂更有效","Switch stance for ghosts","教程"],["text_tutorial_ultimate","点击终极并画出封印","Tap Ultimate and draw the seal","教程"],["text_skill_blade_echo","追影刀光","Echo Slash","技能名"],["text_skill_talisman_bind","缚妖圈","Demon Binding Circle","技能名"],["text_skill_ultimate_seal","天地封妖令","Heaven-Earth Seal","技能名"],["text_skill_blade_echo_desc","连续精准命中后，下一笔产生追击刀光","Creates an echo slash after precise hits","技能说明"],["text_skill_talisman_bind_desc","画出闭合符圈，定身圈内敌人","Draw a closed circle to bind enemies","技能说明"],["text_skill_ultimate_desc","画出封印，对全场造成伤害并压制Boss","Draw a seal to damage all enemies","技能说明"],["text_buff_slow","迟缓","Slow","Buff"],["text_buff_stun","眩晕","Stun","Buff"],["text_buff_burn","灼烧","Burn","Buff"],["text_buff_bind","束缚","Bind","Buff"],["text_buff_vulnerable","破绽","Vulnerable","Buff"],["text_modifier_none","普通","Normal","Modifier"],["text_modifier_elite","精英","Elite","Modifier"],["text_boss_phase1","破除四枚符钉","Break the four seal pins","Boss phase"],["text_boss_phase2","按方向斩开腹部封印","Slash the seal in sequence","Boss phase"],["text_boss_phase3","斜斩打断冲撞，随后处决玄甲王","Interrupt the charge with a diagonal slash, then execute the Tomb King","Boss phase"],["text_buff_shield","护盾","Shield","Buff"],["text_ui_combo","连斩","Combo","HUD连斩标签"],["text_ui_cooldown","冷却","Cooldown","技能冷却标签"],["text_ui_defeat","败北","Defeat","失败结算标题"],["text_ui_energy","能量","Energy","HUD能量标签"],["text_ui_hp","生命","HP","HUD生命标签"],["text_ui_main_menu","返回主菜单","Main Menu","返回主菜单按钮"],["text_ui_next_level","下一关","Next Level","结算下一关按钮"],["text_ui_pause","暂停","Pause","暂停按钮"],["text_ui_paused","战斗已暂停","Battle Paused","暂停面板标题"],["text_ui_ready","可释放","Ready","技能可释放状态"],["text_ui_restart","重新挑战","Restart","结算重开按钮"],["text_ui_resume","继续","Resume","继续按钮"],["text_ui_reward_feature","解锁功能","Feature Unlocked","解锁功能奖励标签"],["text_ui_reward_level","解锁关卡","Level Unlocked","解锁关卡奖励标签"],["text_ui_reward_score_token","镇妖积分","Demon Score","非付费积分奖励标签"],["text_ui_rewards","奖励","Rewards","结算奖励标题"],["text_ui_score","评分","Score","HUD评分标签"],["text_ui_stance","架势","Stance","HUD架势标签"],["text_ui_stars","星级","Stars","结算星级标签"],["text_ui_victory","胜利","Victory","胜利结算标题"],[null,null,null,null],[null,null,null,null],[null,null,null,null]]}
